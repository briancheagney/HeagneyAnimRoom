// room script file

function room_FirstLoad()
{
RemoveWalkableArea(2);
}

function oBadge_Interact(Object *theObject, CursorMode mode)
{
WalkToObjectAndPickup(theObject);
player.AddInventory(iBadge);
PlayerHasBadge=true;
}

function room_RepExec()
{
if (CanPassTape==true)
{
  CanPassTape=false;
  oPoliceTape.X=5000;
  RestoreWalkableArea(2);
}
}


function oBalloon_Interact(Object *theObject, CursorMode mode)
{
WalkToAndJumpUp(theObject, 30, iBalloon);
}
